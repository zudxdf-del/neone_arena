const mineflayer = require('mineflayer')
const { pathfinder, Movements, goals } = require('mineflayer-pathfinder')
const minecraftData = require('minecraft-data')
const fs = require('fs')

const CONFIG={host:process.env.MC_HOST||'funvanillaworld.aternos.me',port:Number(process.env.MC_PORT||57004),username:process.env.MC_USERNAME||'Bot_Vanilla',version:process.env.MC_VERSION||'1.21.11',ollamaUrl:process.env.OLLAMA_URL||'http://127.0.0.1:11434/api/generate',ollamaModel:process.env.OLLAMA_MODEL||'llama3',memoryFile:process.env.MEMORY_FILE||'./memory.json'}
const sleep=ms=>new Promise(r=>setTimeout(r,ms))
const ORES=new Set(['coal_ore','deepslate_coal_ore','iron_ore','deepslate_iron_ore','copper_ore','deepslate_copper_ore','gold_ore','deepslate_gold_ore','redstone_ore','deepslate_redstone_ore','lapis_ore','deepslate_lapis_ore','diamond_ore','deepslate_diamond_ore','emerald_ore','deepslate_emerald_ore','nether_gold_ore','nether_quartz_ore','ancient_debris'])
const HOSTILE=new Set(['zombie','skeleton','creeper','spider','cave_spider','drowned','husk','stray','witch','pillager','vindicator','evoker','ravager','silverfish','endermite','phantom','piglin_brute'])
const OPEN=new Set(['air','cave_air','void_air','water','lava','short_grass','tall_grass','fern','large_fern','snow','vine','glow_lichen'])

class Memory{
 constructor(file){this.file=file;this.data=this.load()}
 load(){try{if(fs.existsSync(this.file))return JSON.parse(fs.readFileSync(this.file,'utf8'))}catch(e){console.log('[MEMORY]',e.message)}return{players:{},locations:{},discoveries:[],history:[]}}
 save(){try{fs.writeFileSync(this.file,JSON.stringify(this.data,null,2))}catch(e){console.log('[MEMORY SAVE]',e.message)}}
 player(name,patch={}){const old=this.data.players[name]||{name,interactions:0};this.data.players[name]={...old,...patch,interactions:(old.interactions||0)+1,lastSeen:Date.now()};this.save()}
 location(name,p,note=''){this.data.locations[name]={name,x:Math.round(p.x),y:Math.round(p.y),z:Math.round(p.z),note,updatedAt:Date.now()};this.save()}
 event(text,data={}){this.data.history.push({text,...data,at:Date.now()});this.data.history=this.data.history.slice(-100);this.save()}
}

class World{
 constructor(bot){this.bot=bot}
 snapshot(){const p=this.bot.entity?.position;return{position:p?{x:Math.round(p.x),y:Math.round(p.y),z:Math.round(p.z)}:null,health:this.bot.health,food:this.bot.food,dimension:this.bot.game?.dimension,time:this.bot.time?.time,day:this.bot.time?.isDay,inventory:this.bot.inventory.items().map(i=>({name:i.name,count:i.count})),players:Object.values(this.bot.players).filter(p=>p.username).map(p=>({name:p.username,visible:Boolean(p.entity)})),entities:this.entities()}}
 entities(radius=20){if(!this.bot.entity)return[];return Object.values(this.bot.entities).filter(e=>e?.position&&e!==this.bot.entity).map(e=>({name:e.username||e.name||e.type,type:e.type,distance:Number(e.position.distanceTo(this.bot.entity.position).toFixed(1)),x:Math.round(e.position.x),y:Math.round(e.position.y),z:Math.round(e.position.z)})).filter(e=>e.distance<=radius).sort((a,b)=>a.distance-b.distance).slice(0,30)}
 danger(radius=10){if(!this.bot.entity)return null;return Object.values(this.bot.entities).filter(e=>e?.position&&e.type==='mob'&&HOSTILE.has(e.name)).map(e=>({entity:e,distance:e.position.distanceTo(this.bot.entity.position)})).filter(x=>x.distance<=radius).sort((a,b)=>a.distance-b.distance)[0]||null}
}

class Agent{
 constructor(bot){this.bot=bot;this.world=new World(bot);this.memory=new Memory(CONFIG.memoryFile);this.taskId=0;this.busy=false;this.following=null;this.lastDanger=0}
 say(text){const s=String(text||'').replace(/\s+/g,' ').trim().slice(0,240);if(s)this.bot.chat(s)}
 cancel(message=''){this.taskId++;this.busy=false;this.following=null;this.bot.pathfinder.setGoal(null);if(message)this.say(message)}
 async askAI(message,user){const prompt=`Ты Minecraft AI-агент Bot_Vanilla. У тебя НЕТ X-Ray. Ты не можешь видеть блоки сквозь стены и не можешь знать координаты скрытых руд. Для добычи используй только физически наблюдаемый мир. Если ресурс не виден, исследуй местность или копай обычную разведочную выработку. Никогда не выдумывай найденные ресурсы или координаты.\nМИР:${JSON.stringify(this.world.snapshot())}\nПАМЯТЬ:${JSON.stringify(this.memory.data.players[user]||{})}\nИСТОРИЯ:${JSON.stringify(this.memory.data.history.slice(-10))}\nИГРОК ${user}: ${message}\nДействия: chat,follow,stop,jump,mine,explore,go_to_player,inspect,remember,none. Ответ только JSON: {"actions":[{"type":"chat|follow|stop|jump|mine|explore|go_to_player|inspect|remember|none","target":"","count":0,"key":"","value":"","text":""}]}`;try{const r=await fetch(CONFIG.ollamaUrl,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:CONFIG.ollamaModel,prompt,stream:false,format:'json'})});if(!r.ok)throw Error(`Ollama HTTP ${r.status}`);const d=await r.json();let raw=String(d.response||'').trim(),a=raw.indexOf('{'),b=raw.lastIndexOf('}');if(a>=0&&b>a)raw=raw.slice(a,b+1);const p=JSON.parse(raw);return Array.isArray(p.actions)?p.actions.slice(0,4):[]}catch(e){console.log('[AI]',e.message);return this.fallback(message,user)}}
 fallback(message,user){const m=message.toLowerCase();if(/стой|останов|отмен/.test(m))return[{type:'stop'}];if(/ко мне|иди сюда|за мной|следуй/.test(m))return[{type:'go_to_player'}];if(/прыг/.test(m))return[{type:'jump'}];if(/исслед|развед|поищ/.test(m))return[{type:'explore'}];if(/что вокруг|осмотр|обстановка/.test(m))return[{type:'inspect'}];const x=m.match(/(?:добудь|накопай|собери|найди|принеси|сруби)\s*(\d+)?\s*(камн|булыж|дерев|бревн|угл|желез|мед|золот|алмаз|изумруд|редстоун|лазур|земл|песок|гравий)/i);if(x){const map={камн:'stone',булыж:'cobblestone',дерев:'log',бревн:'log',угл:'coal_ore',желез:'iron_ore',мед:'copper_ore',золот:'gold_ore',алмаз:'diamond_ore',изумруд:'emerald_ore',редстоун:'redstone_ore',лазур:'lapis_ore',земл:'dirt',песок:'sand',гравий:'gravel'};const k=Object.keys(map).find(k=>x[2].includes(k));return[{type:'mine',target:map[k],count:Number(x[1]||10)}]}return[{type:'chat',text:`Слышу тебя, ${user}. Могу исследовать мир, реально добывать ресурсы, следовать за тобой и защищаться.`}]}
 async execute(actions,user){for(const a of actions){if(!a?.type)continue;if(a.type==='chat')this.say(a.text);else if(a.type==='stop')this.cancel('Остановился.');else if(a.type==='jump'){this.bot.setControlState('jump',true);await sleep(180);this.bot.setControlState('jump',false)}else if(a.type==='go_to_player'||a.type==='follow')await this.goToPlayer(user);else if(a.type==='mine')await this.mine(String(a.target||'stone'),Math.min(64,Math.max(1,Number(a.count)||1)),user);else if(a.type==='explore')await this.explore();else if(a.type==='inspect')this.report(user);else if(a.type==='remember'){this.memory.event(`${a.key||'fact'}: ${a.value||''}`);this.say('Запомнил.')}}}
 async goToPlayer(user){const p=this.bot.players[user]?.entity;if(!p){this.say(`Я пока не вижу тебя, ${user}.`);return}this.cancel();this.following=user;this.bot.pathfinder.setGoal(new goals.GoalFollow(p,2),true);this.say('Иду к тебе.')}
 match(b,t){if(!b)return false;const a={log:['oak_log','birch_log','spruce_log','jungle_log','acacia_log','dark_oak_log','mangrove_log','cherry_log'],stone:['stone','cobblestone','deepslate'],dirt:['dirt','grass_block','coarse_dirt','rooted_dirt'],sand:['sand','red_sand']};return(a[t]||[t]).includes(b.name)}
 exposed(b){if(!b?.position)return false;const p=b.position,n=[this.bot.blockAt(p.offset(1,0,0)),this.bot.blockAt(p.offset(-1,0,0)),this.bot.blockAt(p.offset(0,1,0)),this.bot.blockAt(p.offset(0,-1,0)),this.bot.blockAt(p.offset(0,0,1)),this.bot.blockAt(p.offset(0,0,-1))];if(!n.some(x=>!x||OPEN.has(x.name)||x.boundingBox==='empty'))return false;try{if(typeof this.bot.canSeeBlock==='function'&&!this.bot.canSeeBlock(b))return false}catch(_){}return true}
 findVisible(target,radius=32){const ps=this.bot.findBlocks({maxDistance:radius,count:120,matching:b=>this.match(b,target)});for(const p of ps){const b=this.bot.blockAt(p);if(this.exposed(b))return b}return null}
 findVisibleOre(target,radius=32){const equivalents={coal_ore:['coal_ore','deepslate_coal_ore'],iron_ore:['iron_ore','deepslate_iron_ore'],copper_ore:['copper_ore','deepslate_copper_ore'],gold_ore:['gold_ore','deepslate_gold_ore'],redstone_ore:['redstone_ore','deepslate_redstone_ore'],lapis_ore:['lapis_ore','deepslate_lapis_ore'],diamond_ore:['diamond_ore','deepslate_diamond_ore'],emerald_ore:['emerald_ore','deepslate_emerald_ore']};const wanted=equivalents[target]||[target];const ps=this.bot.findBlocks({maxDistance:radius,count:120,matching:b=>wanted.includes(b.name)});for(const p of ps){const b=this.bot.blockAt(p);if(this.exposed(b))return b}return null}
 async moveNear(p,id,timeout=18000){this.bot.pathfinder.setGoal(new goals.GoalNear(p.x,p.y,p.z,2));const start=Date.now();while(Date.now()-start<timeout){if(id!==this.taskId||!this.bot.entity)return false;if(this.bot.entity.position.distanceTo(p)<=3.5){this.bot.pathfinder.setGoal(null);return true}if(this.world.danger())await this.defend(id);await sleep(250)}this.bot.pathfinder.setGoal(null);return false}
 count(target){const r=target==='log'?/_log$/:target==='stone'?/^(stone|cobblestone|deepslate)$/:target==='diamond_ore'?/^diamond$/:target==='iron_ore'?/^(raw_iron|iron_ore|deepslate_iron_ore)$/:target==='gold_ore'?/^(raw_gold|gold_ore|deepslate_gold_ore)$/:target==='coal_ore'?/^(coal|coal_ore|deepslate_coal_ore)$/:target==='copper_ore'?/^(raw_copper|copper_ore|deepslate_copper_ore)$/:target==='redstone_ore'?/^redstone$/:target==='lapis_ore'?/^lapis_lazuli$/:target==='emerald_ore'?/^emerald$/:new RegExp(`^${target.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}$`);return this.bot.inventory.items().filter(i=>r.test(i.name)).reduce((n,i)=>n+i.count,0)}
 async tool(name){const type=name.includes('log')?'axe':name.includes('dirt')||name.includes('grass')||name.includes('sand')||name.includes('gravel')?'shovel':name.includes('ore')||['stone','cobblestone','deepslate'].includes(name)?'pickaxe':null;if(!type)return false;const items=this.bot.inventory.items().filter(i=>i.name.endsWith(`_${type}`));if(!items.length)return false;const rank=i=>['wooden','golden','stone','iron','diamond','netherite'].findIndex(t=>i.name.startsWith(t));items.sort((a,b)=>rank(b)-rank(a));await this.bot.equip(items[0],'hand');return true}
 async dig(b,user,id){const before=this.count(b.name);await this.tool(b.name);try{await this.bot.lookAt(b.position.offset(.5,.5,.5),true);await this.bot.dig(b,true)}catch(e){console.log('[DIG]',e.message);return false}await sleep(400);const after=this.count(b.name);this.memory.event('mined',{block:b.name,x:b.position.x,y:b.position.y,z:b.position.z,gained:after-before});return after>before||!this.bot.blockAt(b.position)?.name}
 async mine(target,total,user){if(this.busy){this.say('Я уже занят. Скажи «бот, стой».');return}this.busy=true;const id=++this.taskId;let got=0;try{this.say(`Ищу ${target} обычным способом, без X-Ray.`);for(let attempts=0;got<total&&attempts<40&&id===this.taskId;attempts++){let b=this.findVisible(target);if(!b&&ORES.has(target))b=this.findVisibleOre(target);if(b){const before=this.count(target);if(await this.moveNear(b.position,id)&&await this.dig(b,user,id)){const delta=Math.max(0,this.count(target)-before);got+=delta||1;continue}}if(!await this.prospect(id))break}if(got)this.say(`Готово. Реально добыл ${got} шт. ${target}.`);else if(id===this.taskId)this.say(`Не нашёл ${target} в доступной для обычного исследования области.`)}finally{if(id===this.taskId)this.busy=false}}
 async prospect(id){if(!this.bot.entity||id!==this.taskId)return false;const yaw=this.bot.entity.yaw,dirs=[{x:Math.round(-Math.sin(yaw)),z:Math.round(-Math.cos(yaw))},{x:Math.round(Math.cos(yaw)),z:Math.round(-Math.sin(yaw))},{x:Math.round(Math.sin(yaw)),z:Math.round(Math.cos(yaw))}];const d=dirs[Math.floor(Math.random()*dirs.length)];for(let i=0;i<8&&id===this.taskId;i++){const p=this.bot.entity.position,front=this.bot.blockAt(p.offset(d.x,0,d.z)),head=this.bot.blockAt(p.offset(d.x,1,d.z));if(front&&!OPEN.has(front.name)&&front.name!=='bedrock'){await this.tool(front.name);try{await this.bot.lookAt(front.position.offset(.5,.5,.5),true);await this.bot.dig(front,true)}catch(_) {}}if(head&&!OPEN.has(head.name)&&head.name!=='bedrock'){try{await this.bot.lookAt(head.position.offset(.5,.5,.5),true);await this.bot.dig(head,true)}catch(_) {}}this.bot.setControlState('forward',true);await sleep(700);this.bot.setControlState('forward',false);if(this.findVisibleOre(8))return true}this.bot.setControlState('forward',false);const s=this.bot.entity.position.clone(),a=Math.random()*Math.PI*2;return this.moveNear({x:s.x+Math.cos(a)*16,y:s.y,z:s.z+Math.sin(a)*16},id,15000)}
 async explore(){if(this.busy){this.say('Я уже занят.');return false}this.busy=true;const id=++this.taskId;try{const p=this.bot.entity.position.clone(),a=Math.random()*Math.PI*2,ok=await this.moveNear({x:p.x+Math.cos(a)*20,y:p.y,z:p.z+Math.sin(a)*20},id,15000);if(ok){this.memory.location(`explore_${Date.now()}`,this.bot.entity.position,'Физически исследованная область');this.say('Разведка закончена.')}return ok}finally{if(id===this.taskId)this.busy=false}}
 async defend(id=this.taskId){const d=this.world.danger();if(!d||id!==this.taskId)return false;if(Date.now()-this.lastDanger>5000){this.lastDanger=Date.now();this.say(`Вижу ${d.entity.name}. Защищаюсь.`)}const w=this.bot.inventory.items().filter(i=>/_sword$|_axe$/.test(i.name))[0];if(w)try{await this.bot.equip(w,'hand')}catch(_){}try{if(d.distance<=4.5)this.bot.attack(d.entity);else this.bot.pathfinder.setGoal(new goals.GoalNear(d.entity.position.x,d.entity.position.y,d.entity.position.z,3));await sleep(500)}catch(_){}return true}
 report(user){const s=this.world.snapshot(),p=s.position;this.say(`Я на ${p?.x}, ${p?.y}, ${p?.z}. HP ${Math.round(s.health)}, еда ${Math.round(s.food)}. Игроков рядом: ${s.players.filter(x=>x.visible&&x.name!==this.bot.username).length}.`);this.memory.player(user,{lastPosition:p})}
 async chat(user,msg){if(!msg||user===this.bot.username)return;this.memory.player(user);this.memory.event('chat',{user,msg});const l=msg.toLowerCase();if(/^бот[, ]*(стой|остановись|отмена)/.test(l)){this.cancel('Задачу отменил. Стою.');return}if(!this.busy&&!/бот|bot/i.test(msg))return;const clean=msg.replace(/^(бот|bot)[,!: ]*/i,'').trim();await this.execute(await this.askAI(clean||msg,user),user)}
 async autonomous(){if(!this.bot.entity)return;if(!this.busy&&this.world.danger())await this.defend(this.taskId);for(const p of Object.values(this.bot.players)){if(p.username&&p.entity)this.memory.player(p.username,{lastPosition:{x:Math.round(p.entity.position.x),y:Math.round(p.entity.position.y),z:Math.round(p.entity.position.z)}})}if(!this.busy&&this.bot.food<=6){const food=this.bot.inventory.items().find(i=>/bread|apple|cooked_|beef|porkchop|chicken|mutton|rabbit/.test(i.name));if(food)try{await this.bot.equip(food,'hand');await this.bot.consume();this.say('Я поел, чтобы продолжить работу.')}catch(_) {}}}
}

function createBot(){const bot=mineflayer.createBot({host:CONFIG.host,port:CONFIG.port,username:CONFIG.username,version:CONFIG.version});bot.loadPlugin(pathfinder);let agent=null;bot.once('spawn',()=>{const data=minecraftData(bot.version),movements=new Movements(bot,data);movements.canDig=true;movements.allow1by1towers=false;movements.allowFreeMotion=false;movements.allowParkour=true;movements.allowSprinting=true;bot.pathfinder.setMovements(movements);agent=new Agent(bot);bot.chat('AI-агент онлайн. Я вижу настоящий мир и не использую X-Ray.');console.log(`[BOT] ${CONFIG.username} подключён к ${CONFIG.host}:${CONFIG.port}`)});bot.on('chat',async(u,m)=>{try{if(agent)await agent.chat(u,m)}catch(e){console.log('[CHAT ERROR]',e.message)}});bot.on('health',()=>{if(agent&&bot.health<=6)agent.say('У меня мало здоровья, стараюсь выжить.')});bot.on('death',()=>{if(agent)agent.cancel('Я погиб. Задачи сброшены.')});bot.on('kicked',r=>console.log('[KICKED]',r));bot.on('error',e=>console.log('[ERROR]',e.message));bot.on('end',()=>{console.log('[BOT] Соединение закрыто. Переподключение через 8 секунд...');setTimeout(createBot,8000)});setInterval(()=>agent?.autonomous().catch(e=>console.log('[AUTO]',e.message)),5000)}
createBot()
